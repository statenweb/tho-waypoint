{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "color": {
      "custom": true,
      "customGradient": true,
      "link": true,
      "palette": [
        {
          "slug": "medium-blue",
          "color": "#0173B7",
