          "color": "#f9f9f9",
          "name": "Body Background"
        },
        {
          "slug": "body-text",
          "color": "#030D1F",
          "name": "Body Text"
        },
        {
          "slug": "primary",
          "color": "#030D1F",
          "name": "Primary"
        },
        {
          "slug": "secondary",
          "color": "#D33414",
          "name": "Secondary"
        },
        {
